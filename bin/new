#!/bin/bash
set -euo pipefail

# Usage: bin/new 文章标题
title="$*"
[ -z "$title" ] && echo "Usage: bin/new 文章标题" && exit 1

cd "$(dirname "$0")/.."
post_date=$(date +%Y-%m-%d)
post_time=$(date '+%Y-%m-%dT%H:%M:%S%z' | sed -E 's/([+-][0-9]{2})([0-9]{2})$/\1:\2/')
slug=$(printf '%s' "$title" | sed 's/[[:space:]]/-/g; s/[\/\\:：*?"<>|#%]//g')
path="_posts/${post_date}-${slug}.md"
escaped_title=$(printf '%s' "$title" | sed "s/'/''/g")

if [ -e "$path" ]; then
  echo "Already exists: $path" >&2
  exit 1
fi

cat > "$path" << EOF
---
title: '$escaped_title'
date: $post_time
url: /$slug/
tags: []
categories: []
---
EOF

echo "Created: $path"
